{
  "name": "medsafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.cjs",
    "db:seed": "tsx -e \"import('./src/lib/db/seed').then(m => { m.seedIfEmpty(); console.log('Seed complete.'); })\"",
    "db:reset": "node -e \"const fs=require('fs'); for (const f of ['medsafe.db','medsafe.db-wal','medsafe.db-shm']) if (fs.existsSync(f)) fs.unlinkSync(f); console.log('Database files removed; they will be recreated on next boot or seed.')\"",
    "db:backup": "node scripts/db-backup.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
